<service>
	<id>ynotposbackend.exe</id>
	<name>YNOT POS Backend</name>
	<description>Restaurant POS Backend Service</description>
	<executable>C:\Program Files\nodejs\node.exe</executable>
	<argument>--harmony</argument>
	<argument>E:\legend-pos-v5-ynot\pos-app\backend\node_modules\node-windows\lib\wrapper.js</argument>
	<argument>--file</argument>
	<argument>E:\legend-pos-v5-ynot\pos-app\backend\index.js</argument>
	<argument>--scriptoptions=</argument>
	<argument>--log</argument>
	<argument>YNOT POS Backend wrapper</argument>
	<argument>--grow</argument>
